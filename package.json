{
  "name": "meenakshi-build-world",
  "version": "2.0.0",
  "description": "Meenakshi Build World - Next.js frontend (MyTyles-style mega menu) + Express API",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"node server/server.js\" \"next dev -p 3001\"",
    "dev:api": "node server/server.js",
    "dev:web": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "start:api": "node server/server.js",
    "seed": "node server/seed.js",
    "migrate:parking-tiles": "node server/migrate-parking-tiles.js",
    "migrate:ceramic-tiles": "node server/migrate-ceramic-tiles.js",
    "migrate:other-tile-areas": "node server/migrate-other-tile-areas.js",
    "import:somany": "python3 scripts/import_somany_products.py",
    "export:mysql": "python3 scripts/export_mysql.py"
  },
  "keywords": [
    "tile-marketplace",
    "ecommerce",
    "enterprise",
    "room-visualizer",
    "tile-calculator",
    "postgresql",
    "express"
  ],
  "author": "Meenakshi Build World",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "framer-motion": "^11.3.28",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "~3.24.4",
    "next": "^15.5.27",
    "nodemailer": "^10.0.13",
    "pg": "^8.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "optionalDependencies": {
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "concurrently": "^8.2.2",
    "postcss": "8.5.28",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "@types/node": "26.6.3",
    "shell-quote": "1.11.0",
    "postcss": "$postcss"
  }
}
