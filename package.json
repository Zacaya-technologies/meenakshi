{
  "name": "meenakshi-build-world",
  "version": "2.0.0",
  "description": "Meenakshi Build World - Next.js frontend (MyTyles-style mega menu) + Express API",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"node server/server.js\" \"next dev -p 3001\"",
    "dev:api": "node server/server.js",
    "dev:web": "next dev -p 3001",
    "build": "next build",
    "start": "node server/server.js",
    "start:web": "next start -p 3001",
    "seed": "node server/seed.js"
  },
  "keywords": [
    "tile-marketplace",
    "ecommerce",
    "enterprise",
    "room-visualizer",
    "tile-calculator",
    "postgresql",
    "express"
  ],
  "author": "Meenakshi Build World",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "framer-motion": "^11.3.28",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "next": "^14.2.5",
    "nodemailer": "^9.0.4",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.7"
  }
}
